##############################################
# .env.example — placeholder environment file
# DO NOT store real secrets in this file. Use GitHub repository secrets or a local `.env`.
# Lines marked with "# pragma: allowlist secret" are safe placeholder values and will be ignored by
# detect-secrets if present in CI. This file is allowed to contain placeholder (empty) values.
##############################################

DATABASE_URL="SET_DATABASE_URL_IN_GITHUB_SECRETS" # pragma: allowlist secret
# DATABASE_URL="SET_DATABASE_URL_HERE_FOR_LOCAL_DEVELOPMENT"

# GitHub App (release authentication)
APP_ID="ADD_ID_FOR_BOT_GITHUB_APP_IN_GITHUB_SECRETS" # pragma: allowlist secret
APP_PRIVATE_KEY_B64="ADD_BASE64_ENCODED_PRIVATE_KEY_FOR_GITHUB_APP_IN_GITHUB_SECRETS" # pragma: allowlist secret

DEBUG_MODE="SET_DEBUG_MODE_HERE"

# Optional: Render webhook URL used by CD workflow (main branch only)
DEPLOY_URL="SET_DEPLOY_URL_IN_GITHUB_SECRETS" # pragma: allowlist secret

# Optional: API keys / secrets used by your app or third-party services
API_KEY="SET_API_KEY_HERE" # pragma: allowlist secret
SECRET="SET_SECRET_HERE" # pragma: allowlist secret

# Optional: GHCR / Docker credentials (local use only) — CI uses GITHUB_TOKEN by default
GHCR_USER="SET_GHCR_USER_HERE" # pragma: allowlist secret
GHCR_PAT="SET_GHCR_PAT_HERE" # pragma: allowlist secret

# Postgres local/dev example
POSTGRES_USER="SET_POSTGRES_USER_HERE"
POSTGRES_PASSWORD="SET_POSTGRES_PASSWORD_HERE" # pragma: allowlist secret
POSTGRES_DB="SET_POSTGRES_DB_HERE"
POSTGRES_PORT="SET_POSTGRES_PORT_HERE"

# Optional: other environment variables used in CI or locally
GITHUB_TOKEN="SET_GITHUB_TOKEN_IN_CI_OR_LEAVE_BLANK" # pragma: allowlist secret

# allow-empty-push: true  # Hint: This file is safe to commit with placeholder values
